  "algorithms": {
    "equal": {
      "id": "equal",
      "label": "균등 분할",
      "description": "접는 축 길이를 panelCount로 균등 분할. Z·이단·병풍에 사용.",
      "params": {},
      "compute": "each = axisLength / panelCount; panels = [each] * panelCount"
    },
    "c_fold_inner_narrow": {
      "id": "c_fold_inner_narrow",
      "label": "C접지 (안쪽 축소)",
      "description": "안쪽으로 말려 들어가는 마지막 패널을 deltaMm만큼 좁히고, 나머지를 바깥 패널에 분배. 합 = axisLength.",
      "params": {
        "deltaMm": { "from": "defaults.innerNarrowDeltaMm", "overridable": true }
      },
      "panelRoles": ["outer", "middle", "inner_tuck"],
      "compute": "inner = floor((axisLength / 3) - deltaMm) 계열 분배; 합이 정확히 axisLength가 되도록 outer·middle 조정. 기본 예 A4 210: 71 / 71 / 68 (delta=2 근사 재분배)."
    },
    "gate_wings_narrow": {
      "id": "gate_wings_narrow",
      "label": "대문 (날개 축소)",
      "description": "좌우 날개 동일 폭, 가운데 나머지. 각 날개에서 deltaMm 축소 반영.",
      "params": {
        "deltaMm": { "from": "defaults.innerNarrowDeltaMm", "overridable": true },
        "centerRatio": { "default": 0.5, "note": "가운데 패널이 전체의 약 50%에 가깝게 (구현 시 인쇄소 템플릿 맞춤)" }
      },
      "panelRoles": ["left_wing", "center_left", "center_right", "right_wing"],
      "compute": "wings narrow by delta; center takes remainder; left_wing ≈ right_wing"
    },
    "roll_progressive_narrow": {
      "id": "roll_progressive_narrow",
      "label": "두루마리 (점진 축소)",
      "description": "바깥→안쪽 순으로 패널마다 deltaMm씩 좁아짐. 합 = axisLength.",
      "params": {
        "deltaMm": { "from": "defaults.innerNarrowDeltaMm", "overridable": true }
      },
      "panelRoles": ["outer", "mid1", "mid2", "inner_tuck"],
      "compute": "outer widest; each subsequent panel -= deltaMm; renormalize sum to axisLength"
    },
    "cross_half": {
      "id": "cross_half",
      "label": "십자 이등분",
      "description": "가로·세로 각각 반 접기. 패널 그리드 2×2.",
      "params": {},
      "compute": "width/2 × height/2 quadrants"
    }
  },

